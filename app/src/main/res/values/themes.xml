<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.MobileLabas" parent="Theme.AppCompat.NoActionBar"/>

    <style name="Theme.MobileLabas" parent="Base.Theme.MobileLabas">
        <item name="appBgContent">@color/bg_content_light</item>
        <item name="appTextPrimary">@color/text_primary_light</item>
        <item name="appInfoIcon">@color/info_icon_light</item>
        <item name="appIconRegular">@color/black</item>
        <item name="appCaption">@color/caption_light</item>
        <item name="appLabel">@color/label_light</item>
        <item name="appAccent">@color/accent_light</item>
        <item name="appOnAccent">@color/on_accent_light</item>

        <item name="android:windowBackground">@color/bg_content_light</item>
        <item name="android:textColorPrimary">@color/text_primary_light</item>
    </style>

    <style name="Theme.MobileLabas.Dark" parent="Base.Theme.MobileLabas">
        <item name="appBgContent">@color/bg_content_dark</item>
        <item name="appTextPrimary">@color/text_primary_dark</item>
        <item name="appInfoIcon">@color/info_icon_dark</item>
        <item name="appIconRegular">@color/white</item>
        <item name="appCaption">@color/caption_dark</item>
        <item name="appLabel">@color/label_dark</item>
        <item name="appAccent">@color/accent_dark</item>
        <item name="appOnAccent">@color/on_accent_dark</item>

        <item name="android:windowBackground">@color/bg_content_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
    </style>

</resources>